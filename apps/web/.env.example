# ─────────────────────────────────────────────────────────────────────────────
# Shade web app — configuration
#
# Copy to `apps/web/.env.local` if you need to override any of these. The
# repo-root `.env.example` is the canonical list for a full-stack run; these are
# the values only the browser bundle knows about.
# ─────────────────────────────────────────────────────────────────────────────

# Where the browser sends API calls.
#
#   empty  → same-origin `/api/*`, proxied by next.config.ts rewrites. Cookies
#            stay first-party, so the httpOnly session cookie needs no CORS
#            preflight and no relaxed SameSite. This is the development default.
#   set    → an absolute URL, e.g. https://api.shade.dev — use this when the API
#            is deployed on its own origin.
NEXT_PUBLIC_API_BASE_URL=

# Where the Next dev server proxies `/api/*` to. Server-side only; never
# exposed to the browser, so it can be an internal hostname in production.
API_PROXY_TARGET=http://localhost:4000

# Shown in the shell and the document title.
NEXT_PUBLIC_APP_NAME=Shade
