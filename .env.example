# ─────────────────────────────────────────────────────────────────────────────
# Shade — environment configuration
#
# Copy to `.env` at the repo root:  cp .env.example .env
# Each app also reads its own `apps/*/.env.example`; the values below are the
# canonical source of truth for a local full-stack run.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Control plane (Node API) ─────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (CORS + credential policy)
API_CORS_ORIGINS=http://localhost:3000
# Used to sign short-lived upload tickets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHADE_SECRET=dev-only-insecure-secret-replace-me-0000000000000000000000000000
# Session cookie lifetime in days
SESSION_TTL_DAYS=30

# ── Anonymous (pre-auth) usage ───────────────────────────────────────────────
# Number of processing jobs an anonymous browser session may run before it is
# asked to create an account. Enforced server-side.
ANONYMOUS_JOB_QUOTA=1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://shade:shade@localhost:5432/shade
PGPOOL_MAX=10

# ── Redis (job orchestration) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# `redis`  — jobs are pushed to Redis and consumed by the Python worker (default)
# `inline` — dev fallback: jobs are fulfilled in-process by the mock engine.
#            Lets you demo the full flow with no Redis and no Python running.
QUEUE_DRIVER=redis
SHADE_JOB_QUEUE=shade:jobs

# ── Object storage ───────────────────────────────────────────────────────────
# `local` — filesystem adapter (development default)
# `s3`    — S3 / MinIO adapter (stub in this milestone)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.data/storage
# Presigned upload ticket lifetime, seconds
UPLOAD_TICKET_TTL_SECONDS=900
MAX_UPLOAD_BYTES=52428800
# S3 / MinIO (only read when STORAGE_DRIVER=s3)
S3_BUCKET=shade-dev
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Processing plane (Python worker) ─────────────────────────────────────────
# Shared secret the worker presents on internal callbacks. Must match the API.
WORKER_SHARED_TOKEN=dev-worker-token-replace-me
WORKER_CONCURRENCY=2
WORKER_POLL_TIMEOUT_SECONDS=5
# `mock` returns deterministic, realistic fixtures. Swap for a real engine later.
PROCESSOR_ENGINE=mock
PROCESSOR_VERSION=0.1.0
WORKER_STORAGE_ROOT=./.data/storage
# Delivery attempts after which a job is copied to `<queue>:failed`.
WORKER_MAX_ATTEMPTS=3
# Seconds held per stage for uploads whose filename carries the `__slow__` demo
# marker. Set to 0 to disable the slowdown entirely.
WORKER_SLOW_STAGE_SECONDS=0.75
# Identifies this process in Redis in-flight list names and in log lines.
# Defaults to `<hostname>-<pid>`; pin it when running multiple workers.
WORKER_ID=

# ── Web (Next.js) ────────────────────────────────────────────────────────────
# Leave empty to use same-origin `/api/*` (proxied to the API via next.config
# rewrites — keeps cookies first-party in development). Set to an absolute URL
# when the API is deployed on its own origin.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_NAME=Shade
